# Copy this file to .env and fill in both values. `pnpm dev` refuses to start
# without them, on purpose — there is no offline fallback that would not be a
# lie about what this CRM is doing.
#
#   cp .env.example .env
#
# .env is gitignored. Nothing in here is shared between QAs.

# Your API key, from the partner console at https://platform.kaafil.in —
# "API keys" in the left nav (it is a top-level item, not under Settings),
# then create one. Copy it at creation time; the secret is shown exactly once.
#
# SERVER-ONLY. This variable is read by server/ and tools/ (both started with
# `tsx --env-file=.env`) and by nothing else. Do NOT rename it to VITE_ANYTHING
# and do not import it from app/: Vite inlines every VITE_-prefixed variable
# into the browser bundle, and a partner API key in a browser bundle is a
# compromised tenant. The browser only ever holds a short-lived session token
# that the server mints for it.
#
# A kf_test_ key runs against the sandbox plane; a kf_live_ key is real. Either
# works here, and the server prints which one it detected at boot along with
# what the choice costs you.
KAAFIL_API_KEY=kf_test_replace_me

# Your id for the agency these trips belong to — you choose the string, Kaafil
# stores it as the agency's external reference and you address the agency by it
# forever after. Anything stable and unique within your tenant is fine; the
# fixture's own agency code is a sensible default.
KAAFIL_AGENCY_REF=sharma-travels
